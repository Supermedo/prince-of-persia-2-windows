#include <windows.h>

#ifdef HAVE_ART
1 ICON "launcher.ico"
2 ICON "pop2.ico"
100 BITMAP "banner.bmp"
#endif
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Prince of Persia 2 Launcher"
      VALUE "ProductName", "Prince of Persia 2 - The Shadow and the Flame"
      VALUE "FileVersion", "1.0"
      VALUE "OriginalFilename", "PoP2 Launcher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
