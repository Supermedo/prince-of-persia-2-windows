#include <windows.h>

#ifdef HAVE_ART
1 ICON "pop2.ico"
#endif
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Supermedo"
      VALUE "FileDescription", "Prince of Persia 2 (native port)"
      VALUE "ProductName", "Prince of Persia 2 - The Shadow and the Flame"
      VALUE "FileVersion", "1.0"
      VALUE "OriginalFilename", "pop2.exe"
      VALUE "LegalCopyright", "Port code: open source. Game content: (c) its owners, not included."
      VALUE "Comments", "Static recompilation of the DOS game; requires your own copy. github.com/Supermedo/prince-of-persia-2-windows"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
